.wrap {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}
.title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}
/* 核心：图片+文字横向排列 */
.item {
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
/* 图片样式 */
.record-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
/* 文字区域自适应 */
.text-wrap {
  flex: 1;
}
.ok {
  color: green;
  font-weight: bold;
}
.no {
  color: red;
  font-weight: bold;
}
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}