.container {
  width: 100vw;
  height: 100vh;
  background: #ffffff;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.camera-box {
  position: relative;
  width: 600rpx;
  height: 800rpx;
  margin-top: 80rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

camera {
  width: 100%;
  height: 100%;
  display: block;
}

.face-frame {
  display: none !important;
}

.result-box {
  position: fixed;
  bottom: 180rpx;
  background: rgba(255,255,255,0.85);
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  z-index: 999;
}

.result-text {
  font-size: 32rpx;
  font-weight: bold;
}

.success { color: #00c263; }
.fail { color: #ff3b30; }

.btn {
  position: fixed;
  bottom: 100rpx;
  width: 300rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #007aff;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  z-index: 999;
}

.loading {
  position: fixed;
  bottom: 130rpx;
  color: #fff;
  font-size: 28rpx;
  z-index: 999;
}